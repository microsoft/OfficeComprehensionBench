# Copy to .env and fill in real values.

# === Azure OpenAI (GPT evaluator) ===
# Required. Full endpoint URL of your Azure OpenAI resource.
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
# Optional. Defaults to 2025-03-01-preview.
AZURE_OPENAI_API_VERSION=2025-03-01-preview
# Authentication uses azure-identity DefaultAzureCredential
# (run `az login` locally, or set AZURE_CLIENT_ID/SECRET/TENANT_ID).

# === Google Gemini (optional, for multi-LLM majority voting) ===
GEMINI_API_KEY=your_gemini_api_key_here

# === Anthropic Claude (optional, for multi-LLM majority voting) ===
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# === Adobe PDF Services (optional, only required by download_and_convert_files.py
#     when reference files need to be converted from PDF to .docx/.pptx).
# Create credentials at https://acrobatservices.adobe.com/dc-integration-creation-app-cdn/main.html
PDF_SERVICES_CLIENT_ID=your_adobe_client_id_here
PDF_SERVICES_CLIENT_SECRET=your_adobe_client_secret_here

# === Hugging Face (optional, only needed if the reference dataset is private
#     or gated; public HF datasets download without a token). Get one at
#     https://huggingface.co/settings/tokens
HF_TOKEN=your_hf_token_here

# === SEC EDGAR (required by download_and_convert_files.py for any sec.gov URL).
#     SEC requires a User-Agent identifying the requester. Format: "Name email".
#     See https://www.sec.gov/os/accessing-edgar-data
SEC_USER_AGENT=Your Name your.email@example.com

# === Misc ===
LOG_LEVEL=INFO
OUTPUT_DIR=./Output
